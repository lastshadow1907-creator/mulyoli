<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Muly ❤︎ Olcay</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&family=Sacramento&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #fff0f3;
            --text-color: #593539;
            --card-bg: #ffffff;
            --accent-color: #ff4d6d;
            --accent-hover: #ff1a43;
            --shadow: 0 10px 30px rgba(255, 77, 109, 0.15);
            --border-color: #ffccd5;
        }

        [data-theme="dark"] {
            --bg-color: #0d1117;
            --text-color: #e6edf3;
            --card-bg: #161b22;
            --accent-color: #ff5874;
            --accent-hover: #ff758d;
            --shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            --border-color: #30363d;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; transition: background 0.3s, color 0.3s; }
        body { background-color: var(--bg-color); color: var(--text-color); font-family: 'Poppins', sans-serif; padding: 20px; min-height: 100vh; display: flex; flex-direction: column; align-items: center; }

        .top-bar { position: fixed; top: 20px; right: 20px; display: flex; gap: 10px; z-index: 1000; }
        .icon-btn { background: var(--card-bg); border: 1px solid var(--border-color); color: var(--text-color); width: 45px; height: 45px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; box-shadow: var(--shadow); font-size: 1.2rem; }
        .icon-btn:hover { background: var(--accent-color); color: white; border-color: var(--accent-color); }

        .container { width: 100%; max-width: 800px; display: flex; flex-direction: column; gap: 30px; margin-top: 40px; }

        .card { background: var(--card-bg); border-radius: 24px; padding: 30px; box-shadow: var(--shadow); border: 1px solid var(--border-color); text-align: center; position: relative; }

        h1 { font-family: 'Sacramento', cursive; font-size: 3.5rem; color: var(--accent-color); margin-bottom: 10px; }
        
        .timer-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; margin: 20px 0; }
        .time-box { background: var(--bg-color); padding: 15px; border-radius: 16px; border: 1px solid var(--border-color); }
        .time-box span { display: block; font-size: 1.8rem; font-weight: 600; color: var(--accent-color); }
        .time-box label { font-size: 0.85rem; opacity: 0.8; }

        .month-badge { display: inline-block; background: var(--accent-color); color: white; padding: 6px 16px; border-radius: 20px; font-weight: 500; font-size: 0.95rem; margin-top: 10px; }

        .btn { background: var(--accent-color); color: white; border: none; padding: 12px 24px; border-radius: 14px; font-family: 'Poppins', sans-serif; font-weight: 500; cursor: pointer; box-shadow: var(--shadow); display: inline-flex; align-items: center; gap: 8px; }
        .btn:hover { background: var(--accent-hover); }

        .section-title { font-size: 1.5rem; margin-bottom: 20px; display: flex; align-items: center; justify-content: space-between; }
        
        .gallery-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 20px; }
        .polaroid { background: var(--card-bg); padding: 12px 12px 20px 12px; border-radius: 8px; box-shadow: var(--shadow); border: 1px solid var(--border-color); position: relative; }
        .polaroid img { width: 100%; height: 180px; object-fit: cover; border-radius: 4px; }
        .polaroid .delete-btn { position: absolute; top: 5px; right: 5px; background: rgba(255,0,0,0.7); color: white; border: none; border-radius: 50%; width: 25px; height: 25px; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 12px; }

        .notes-list { display: flex; flex-direction: column; gap: 15px; text-align: left; }
        .note-item { background: var(--bg-color); padding: 15px; border-radius: 12px; border: 1px solid var(--border-color); position: relative; }
        .note-item p { font-size: 0.95rem; margin-bottom: 5px; }
        .note-item small { opacity: 0.7; font-size: 0.8rem; }
        .note-delete { position: absolute; top: 10px; right: 10px; background: none; border: none; color: var(--accent-color); cursor: pointer; font-size: 1rem; }

        .input-group { display: flex; gap: 10px; margin-top: 15px; }
        .input-group input { flex: 1; padding: 12px; border-radius: 12px; border: 1px solid var(--border-color); background: var(--bg-color); color: var(--text-color); font-family: 'Poppins', sans-serif; }

        @media(max-width: 600px) {
            .timer-grid { grid-template-columns: repeat(2, 1fr); }
            h1 { font-size: 2.8rem; }
        }
    </style>
</head>
<body>

    <div class="top-bar">
        <button class="icon-btn" id="musicBtn" title="Müzik Aç/Kapat">🎵</button>
        <button class="icon-btn" id="themeBtn" title="Tema Değiştir">🌙</button>
    </div>

    <div class="container">
        <!-- Sayaç Kartı -->
        <div class="card">
            <h1>Bizim Hikayemiz</h1>
            <p>Birlikte geçen sonsuz anlarımız...</p>
            
            <div class="timer-grid">
                <div class="time-box"><span id="days">0</span><label>Gün (+1)</label></div>
                <div class="time-box"><span id="hours">0</span><label>Saat</label></div>
                <div class="time-box"><span id="minutes">0</span><label>Dakika</label></div>
                <div class="time-box"><span id="seconds">0</span><label>Saniye</label></div>
            </div>
            <div class="month-badge" id="monthBadge">Birlikte 1. Ay İçindeyiz</div>
            
            <div style="margin-top: 20px;">
                <input type="datetime-local" id="startDateInput" value="2026-03-14T00:08" style="padding: 8px; border-radius: 10px; border: 1px solid var(--border-color); background: var(--bg-color); color: var(--text-color);">
                <button class="btn" id="saveDateBtn" style="padding: 8px 15px; margin-left: 5px;">Tarihi Güncelle</button>
            </div>
        </div>

        <!-- Kalp Gönder Butonu -->
        <div class="card" style="text-align: center;">
            <button class="btn" id="loveBtn" style="font-size: 1.1rem; padding: 15px 30px;">❤️ Seni Çok Özledim / Kalp Gönder (<span id="loveCount">0</span>)</button>
        </div>

        <!-- Fotoğraf Galerisi -->
        <div class="card">
            <div class="section-title">
                <span>Anı Galerimiz</span>
                <button class="btn" id="addPhotoBtn">+ Fotoğraf Ekle</button>
            </div>
            <div class="gallery-grid" id="galleryGrid"></div>
        </div>

        <!-- Notlar Kartı -->
        <div class="card">
            <div class="section-title">
                <span>Aşk Notları</span>
            </div>
            <div class="notes-list" id="notesList"></div>
            <div class="input-group">
                <input type="text" id="noteInput" placeholder="Sevgiline tatlı bir not bırak...">
                <button class="btn" id="addNoteBtn">Gönder</button>
            </div>
        </div>
    </div>

    <!-- Gizli Audio -->
    <audio id="bgMusic" loop src="muzik.mp3"></audio>

    <script>
        // Başlangıç Tarihi (14.03.2026 00:08)
        let startDate = localStorage.getItem('startDate') || "2026-03-14T00:08:00";
        document.getElementById('startDateInput').value = startDate.slice(0, 16);

        document.getElementById('saveDateBtn').addEventListener('click', () => {
            const val = document.getElementById('startDateInput').value;
            if(val) {
                startDate = val + ":00";
                localStorage.setItem('startDate', startDate);
                alert("Başlangıç tarihi güncellendi!");
            }
        });

        function updateTimer() {
            const start = new Date(startDate).getTime();
            const now = new Date().getTime();
            let diff = Math.floor((now - start) / 1000);

            if (diff < 0) diff = 0;

            const days = Math.floor(diff / (3600 * 24)) + 1; // +1 Gün kuralı
            const hours = Math.floor((diff % (3600 * 24)) / 3600);
            const minutes = Math.floor((diff % 3600) / 60);
            const seconds = diff % 60;

            document.getElementById('days').innerText = days;
            document.getElementById('hours').innerText = hours;
            document.getElementById('minutes').innerText = minutes;
            document.getElementById('seconds').innerText = seconds;

            // Kaçıncı ay hesabı (+1 ay)
            const startDateObj = new Date(startDate);
            const currentDateObj = new Date();
            let months = (currentDateObj.getFullYear() - startDateObj.getFullYear()) * 12;
            months -= startDateObj.getMonth();
            months += currentDateObj.getMonth();
            if (currentDateObj.getDate() < startDateObj.getDate()) months--;
            let currentMonthNum = months <= 0 ? 1 : months + 1;
            document.getElementById('monthBadge').innerText = `Birlikte ${currentMonthNum}. Ay İçindeyiz`;
        }
        setInterval(updateTimer, 1000);
        updateTimer();

        // Tema Değiştirici
        const themeBtn = document.getElementById('themeBtn');
        let currentTheme = localStorage.getItem('theme') || 'light';
        if(currentTheme === 'dark') document.documentElement.setAttribute('data-theme', 'dark');

        themeBtn.addEventListener('click', () => {
            if (document.documentElement.getAttribute('data-theme') === 'dark') {
                document.documentElement.removeAttribute('data-theme');
                localStorage.setItem('theme', 'light');
                themeBtn.innerText = '🌙';
            } else {
                document.documentElement.setAttribute('data-theme', 'dark');
                localStorage.setItem('theme', 'dark');
                themeBtn.innerText = '☀️';
            }
        });

        // Müzik Çalar
        const music = document.getElementById('bgMusic');
        const musicBtn = document.getElementById('musicBtn');
        let isPlaying = false;
        musicBtn.addEventListener('click', () => {
            if(isPlaying) {
                music.pause();
                musicBtn.innerText = '🎵';
                isPlaying = false;
            } else {
                music.play().then(() => {
                    musicBtn.innerText = '🔇';
                    isPlaying = true;
                }).catch(() => {
                    alert("Lütfen proje klasörüne 'muzik.mp3' adında bir ses dosyası ekleyin!");
                });
            }
        });

        // Kalp Butonu
        let loveCount = parseInt(localStorage.getItem('loveCount') || '0');
        document.getElementById('loveCount').innerText = loveCount;
        document.getElementById('loveBtn').addEventListener('click', () => {
            loveCount++;
            localStorage.setItem('loveCount', loveCount);
            document.getElementById('loveCount').innerText = loveCount;
            alert("❤️ Kalbiniz gönderildi!");
        });

        // Fotoğraf Galerisi
        let photos = JSON.parse(localStorage.getItem('photos') || '[]');
        function renderPhotos() {
            const grid = document.getElementById('galleryGrid');
            grid.innerHTML = '';
            photos.forEach((photo, index) => {
                grid.innerHTML += `
                    <div class="polaroid">
                        <button class="delete-btn" onclick="deletePhoto(${index})">×</button>
                        <img src="${photo}" alt="Anı">
                    </div>`;
            });
        }
        window.deletePhoto = function(index) {
            if(confirm("Bu fotoğrafı silmek istiyor musun?")) {
                photos.splice(index, 1);
                localStorage.setItem('photos', JSON.stringify(photos));
                renderPhotos();
            }
        }
        document.getElementById('addPhotoBtn').addEventListener('click', () => {
            const url = prompt("Fotoğraf bağlantısını (URL) yapıştırın:");
            if(url) {
                photos.push(url);
                localStorage.setItem('photos', JSON.stringify(photos));
                renderPhotos();
            }
        });
        renderPhotos();

        // Notlar
        let notes = JSON.parse(localStorage.getItem('notes') || '[]');
        function renderNotes() {
            const list = document.getElementById('notesList');
            list.innerHTML = '';
            notes.forEach((note, index) => {
                list.innerHTML += `
                    <div class="note-item">
                        <button class="note-delete" onclick="deleteNote(${index})">×</button>
                        <p>${note.text}</p>
                        <small>${note.date}</small>
                    </div>`;
            });
        }
        window.deleteNote = function(index) {
            notes.splice(index, 1);
            localStorage.setItem('notes', JSON.stringify(notes));
            renderNotes();
        }
        document.getElementById('addNoteBtn').addEventListener('click', () => {
            const text = document.getElementById('noteInput').value.trim();
            if(text) {
                const date = new Date().toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });
                notes.push({ text, date });
                localStorage.setItem('notes', JSON.stringify(notes));
                document.getElementById('noteInput').value = '';
                renderNotes();
            }
        });
        renderNotes();
    </script>
</body>
</html>
